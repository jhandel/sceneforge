{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./packages/extension/src/*"],
      "@jhandel/sceneforge": ["./packages/sceneforge/src"],
      "@jhandel/sceneforge/*": ["./packages/sceneforge/src/*"],
      "@jhandel/sceneforge-shared": ["./packages/shared/src"],
      "@jhandel/sceneforge-shared/*": ["./packages/shared/src/*"],
      "@jhandel/sceneforge-playwright": ["./packages/playwright/src"],
      "@jhandel/sceneforge-playwright/*": ["./packages/playwright/src/*"],
      "@jhandel/sceneforge-generation": ["./packages/generation/src"],
      "@jhandel/sceneforge-generation/*": ["./packages/generation/src/*"]
    }
  },
  "include": ["packages/*/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
