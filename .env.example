# ElevenLabs API Configuration for Demo Voiceovers
# Get your API key from: https://elevenlabs.io/app/settings/api-keys

# Required: Your ElevenLabs API key
ELEVENLABS_API_KEY=

# Required: Voice ID for narration
# Run 'bun run voice:list-voices' to see available voices
ELEVENLABS_VOICE_ID=

# Optional: Screenshot/E2E test credentials
EMAIL=
PASSWORD=

