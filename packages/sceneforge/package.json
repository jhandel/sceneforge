{
  "name": "@t3lnet/sceneforge",
  "version": "1.0.10",
  "description": "SceneForge runner and generation utilities for YAML-driven demos",
  "license": "MIT",
  "author": "T3LNET",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhandel/sceneforge.git"
  },
  "bugs": {
    "url": "https://github.com/jhandel/sceneforge/issues"
  },
  "homepage": "https://github.com/jhandel/sceneforge#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "sceneforge": "./cli/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "cli",
    "context",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "elevenlabs": "^1.59.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
